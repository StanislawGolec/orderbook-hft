[Unit]
Description=OrderBook-HFT Market Replay & Nanosecond Profiling Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/orderbook-hft
ExecStart=/opt/orderbook-hft/market_replay --ops 10000000
Restart=always
RestartSec=5s

# Low-Latency Systems Tuning:
# 1. Pin process to CPU core 0 (adapted for single OCPU / Always-Free instance)
CPUAffinity=0

# 2. Maximum priority scheduling
Nice=-20

# 3. Unlimited memory locking to prevent swapping
LimitMEMLOCK=infinity

# 4. Standard process limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
